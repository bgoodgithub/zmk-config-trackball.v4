#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
//#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/ext_power.h>
//#include <behaviors/mouse_keys.dtsi>
//#include <input/processors.dtsi>


// Label re-defined: Fingers - Front, Thumb - Backwards

#define FRONT_RIGHT 0
#define FRONT_LEFT 1
#define BACK_RIGHT 2
#define BACK_LEFT 3
#define F_SCRL 4
#define B_SCRL 5

// Mouse speed increased
#define ZMK_POINTING_DEFAULT_MOVE_VAL 500  // default: 600 - original: 1000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 7   // default: 10  - original: 15
//#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

	// Layer 0 (This is the one that I use)
        FRONT_RIGHT {
            bindings = <
        //  ____________                           ____________
        // |Scroll Layer|                         |Scroll Layer|
		    &mo F_SCRL				               &mo F_SCRL
        // |____________|            O            |____________|
        // |   Enter    |                         |    Copy    |
		    &kp ENTER		        	           &kp LC(C)
        // |____________|____________ ____________|____________|
        // |Right Click |Middle Click| Left Click |   Paste    |
		    &mkp RCLK    &mkp MCLK    &mkp LCLK    &kp LC(V)
        // |____________|____________|____________|____________|
        /*   Orientation (Front/Backward)   Handiness L/R     */
   		  &bt BT_CLR  &bt BT_NXT   &studio_unlock
			/*&kp N1  &kp N2  &kp N3*/
               /* Orientation (Front/Backward)   Handiness L/R     */
			&mo 2                   &mo 1
            >;
        };


	// Layer 1
        FRONT_LEFT {
            bindings = <
        //  ____________                           ____________
        // |            |                         |            |
		    &mkp LCLK 				               &mo F_SCRL
        // |____________|            O            |____________|
        // |            |                         |            |
		    &mkp MCLK				               &mkp MCLK 				
        // |____________|____________ ____________|____________|
        // |            |            |            |            |
            &kp ESC      &kp C        &kp D	       &mkp RCLK
        // |____________|____________|____________|____________|
	                   /* Inner Buttons  */
		            &trans &trans &trans
               /* Orientation (Front/Backward)   Handiness L/R     */
			&trans                  &trans
            >;
        };


	// Layer 2
        BACK_RIGHT {
            bindings = <
        //  ____________                           ____________
        // |   Escape   |                         |Scroll Layer|
		    &kp ESC         			           &mo B_SCRL
        // |____________|            O            |____________|
        // |   Enter    |                         |    Copy    |
		    &kp ENTER     			               &kp LC(C)
        // |____________|____________ ____________|____________|
        // |Middle Click|Right Click | Left Click |   Paste    |
		    &mkp MCLK	 &mkp RCLK    &mkp LCLK	   &kp LC(V)
        // |____________|____________|____________|____________|
	                   /* Inner Buttons  */
		            &trans &trans &trans
               /* Orientation (Front/Backward)   Handiness L/R     */
			&trans                 &trans
            >;
        };
 
	// Layer 3
        BACK_LEFT {
            bindings = <
        //  ____________                           ____________
        // |            |                         |            |
    		&mkp RCLK				               &kp ESC
        // |____________|            O            |____________|
        // |            |                         |            |
	    	&mkp MCLK				               &mkp MCLK
        // |____________|____________ ____________|____________|
        // |            |            |            |            |
		    &mo B_SCRL   &kp E        &kp F	       &mkp LCLK
        // |____________|____________|____________|____________|
	                   /* Inner Buttons  */
		            &trans &trans &trans
               /* Orientation (Front/Backward)   Handiness L/R     */
			&trans                 &trans
            >;
         };    

	// Scroll layers do nothing by themselves, it is completely transparent.
	// It is detected in trackball_listener telling to switch from the pointing movement to scrolling.
	// Need separate layers for orientation to implement 
 	// Layers 4, 5
/* 4 */ F_SCRL      {bindings = <&trans &trans &trans &trans &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 3 &bt BT_SEL 0 &trans &trans &trans &trans &trans>;};
/* 5 */ B_SCRL      {bindings = <&trans &trans &trans &trans &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 3 &bt BT_SEL 0 &trans &trans &trans &trans &trans>;};

        extra1 {status = "reserved";};
        extra2 {status = "reserved";};
        extra3 {status = "reserved";};
        extra4 {status = "reserved";};
        extra5 {status = "reserved";};
        extra6 {status = "reserved";};
        extra7 {status = "reserved";};
        extra8  {status = "reserved";};

     };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <FRONT_LEFT BACK_RIGHT>;
            then-layer = <BACK_LEFT>;
        };
    };

};
